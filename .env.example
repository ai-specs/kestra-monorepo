POSTGRES_PASSWORD=replace-with-a-generated-password
KESTRA_OIDC_UI_CLIENT_SECRET=replace-with-a-generated-client-secret
KESTRA_OIDC_BOOTSTRAP_USERNAME=
KESTRA_OIDC_BOOTSTRAP_PASSWORD=
KESTRA_OIDC_SETUP_ALLOWED=true
KESTRA_RBAC_ENABLED=false
KESTRA_OIDC_REGISTRATION_ENABLED=false
# RBAC=true also requires: openid,profile,email,kestra:application-group-scopes
KESTRA_OIDC_UI_SCOPES=openid,profile,email
# Immutable deployment input; verify the matching acceptance evidence in docs/rbac-acceptance.md.
KESTRA_IMAGE=ghcr.io/ai-specs/kestra-overlay@sha256:50315684e3826c4fafadac834ed1fc5438c3e2c77c394740634b59a1f6591024
# 安装 CLI（ApplicationGroupDirectoryCommand 等）额外要求，Compose 服务环境不包含；
# 通过 docker compose run 执行安装命令时显式传入，见根仓与插件 README 新装章节：
# RBAC_POLICY_JDBC_URL=jdbc:postgresql://postgres:5432/kestra
# RBAC_POLICY_JDBC_USER=kestra
# RBAC_POLICY_JDBC_PASSWORD=<与 POSTGRES_PASSWORD 相同>
